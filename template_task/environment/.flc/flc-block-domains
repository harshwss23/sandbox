#!/usr/bin/env bash
# Point the domains listed in $1 at 0.0.0.0, one per line, blank lines and `#`
# comments ignored. An empty or missing file exits 0 without touching anything.
#
# Docker replaces /etc/hosts per container, so the list is recorded at
# /etc/flc/blocked_domains during the build and re-applied at run time by the
# hook installed below. This is name-level blocking and does not stop a request
# to a raw IP.

set -euo pipefail

file="${1:-}"
record="/etc/flc/blocked_domains"
hook="/etc/profile.d/00-flc-block-domains.sh"

domains=()
if [ -n "$file" ] && [ -f "$file" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="$(printf '%s' "$line" | tr -d '[:space:]')"
    [ -n "$line" ] || continue
    # A URL where a hostname was meant, reduced to the hostname.
    case "$line" in
      *://*) line="${line#*://}" ;;
    esac
    line="${line%%/*}"
    domains+=("$line")
  done < "$file"
fi

mkdir -p "$(dirname "$record")"
: > "$record"

if [ "${#domains[@]}" -eq 0 ]; then
  echo "flc-block-domains: no domains blocked"
  rm -f "$hook"
  exit 0
fi

printf '%s\n' "${domains[@]}" > "$record"

# The applier, used both now and on every shell the agent opens.
cat > /usr/local/bin/flc-apply-blocks <<'APPLY'
#!/usr/bin/env bash
# Append the recorded block list to /etc/hosts. Idempotent: the marked block is
# removed before it is rewritten, so repeated shells do not stack it.
set -euo pipefail
record="/etc/flc/blocked_domains"
[ -s "$record" ] || exit 0
[ -w /etc/hosts ] || exit 0
begin="# >>> flc blocked >>>"
end="# <<< flc blocked <<<"
tmp="$(mktemp)"
awk -v b="$begin" -v e="$end" '$0==b{s=1} !s{print} $0==e{s=0}' /etc/hosts > "$tmp"
{
  printf '%s\n' "$begin"
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    printf '0.0.0.0 %s\n' "$d"
    printf '0.0.0.0 www.%s\n' "$d"
    printf '::1 %s\n' "$d"
    printf '::1 www.%s\n' "$d"
  done < "$record"
  printf '%s\n' "$end"
} >> "$tmp"
cat "$tmp" > /etc/hosts
rm -f "$tmp"
APPLY
chmod +x /usr/local/bin/flc-apply-blocks

# Non-login shells skip profile.d, so bash's own rc file is hooked as well.
# Both point at the same applier.
cat > "$hook" <<'HOOK'
flc-apply-blocks 2>/dev/null || true
HOOK
chmod +x "$hook"

if [ -f /etc/bash.bashrc ] && ! grep -qF 'flc-apply-blocks' /etc/bash.bashrc; then
  printf '\nflc-apply-blocks 2>/dev/null || true\n' >> /etc/bash.bashrc
fi

flc-apply-blocks || true
echo "flc-block-domains: blocked ${#domains[@]} domain(s): ${domains[*]}"
